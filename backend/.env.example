PORT=5000
MONGO_URI=mongodb://localhost:27017/room_harmony

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Initial Admin Credentials
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# Initial Receptionist Credentials
RECEPTIONIST_NAME=Receptionist User
RECEPTIONIST_EMAIL=receptionist@example.com
RECEPTIONIST_PASSWORD=your_receptionist_password

# Initial Visitor Credentials
VISITOR_NAME=Visitor User
VISITOR_EMAIL=visitor@example.com
VISITOR_PASSWORD=your_visitor_password
